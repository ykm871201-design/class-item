{
  "name": "classroom-tools",
  "version": "1.4.1",
  "description": "초등 교사용 교실 도구 (큰 글씨 칠판, 타이머, 자리 배치, 발표 뽑기)",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "node scripts/build.mjs --prod",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "node scripts/build.mjs --prod && electron-builder --win nsis --x64",
    "e2e": "node scripts/build.mjs && node tests-e2e/run.mjs",
    "dist:win:linux": "node scripts/build.mjs --prod && node scripts/dist-win-linux.cjs"
  },
  "keywords": [],
  "author": "Classroom Tools",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {},
  "productName": "교실 도구",
  "build": {
    "appId": "kr.school.classroomtools",
    "productName": "교실 도구",
    "executableName": "ClassroomTools",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "ClassroomTools-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "교실 도구",
      "uninstallDisplayName": "교실 도구",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ykm871201-design/class-item.git"
  }
}
